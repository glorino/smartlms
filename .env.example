# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
AUTH_SECRET="generate-a-unique-secret-here"
NEXTAUTH_SECRET="generate-a-different-unique-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Encryption (required)
# Encrypts sensitive admin settings stored in the DB (SMTP password,
# Flutterwave secret/encryption keys, OpenAI API key).
# Generate a long random string, e.g.: openssl rand -hex 32
# Warning: changing this value makes previously stored secrets undecryptable.
ENCRYPTION_SECRET="generate-a-long-random-string-here"

# App URL (required for emails, payment redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Flutterwave (Payment Gateway)
NEXT_PUBLIC_FLWPUBK="FLWPUBK_TEST-..."
FLWSECK="FLWSECK_TEST-..."
FLW_ENCRYPTION_KEY="FLWSECK_TEST..."

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (optional)
# The GitHub provider is only registered when both keys are set, and the
# "Continue with GitHub" button only renders when NEXT_PUBLIC_GITHUB_ENABLED
# is "true".
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
NEXT_PUBLIC_GITHUB_ENABLED="false"

# OpenAI (optional)
OPENAI_API_KEY="sk_..."

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@smartlms.com
CONTACT_EMAIL=support@smartlms.com
